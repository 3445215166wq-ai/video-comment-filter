# ===== 模型文件 =====
# model.onnx（448MB）超出 GitHub 单文件 100MB 上限，走 Release 附件获取
models/*.onnx
# 分词表（约 4.8MB）为上游原版，随仓库分发
models/*.model
!models/sentencepiece.bpe.model
# 重建过程中的临时产物
models/*.fixed
# 微调用的 PyTorch 权重（448MB），不入库
models/finetune/

# ===== 本地部署目录（可运行成品：exe + Qt 运行时 + 模型）=====
# 由源码构建 + 模型组合而成，可随时重建，不入库
bin/

# ===== 运行期生成的数据 =====
# data/ 下的 config.json 与 *templates/ 样例随仓库分发，
# 以下运行期输出目录不纳入版本控制
data/raw/
data/cleaned/
data/parser/
data/SimilarityCheck/

# ===== IDE / 系统 =====
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# ===== Doxygen 生成物（可随时重生成，见 Doxyfile）=====
# 不纳入版本库：避免文档比源码陈旧（旧版本曾收录 12,533 页第三方文档 / 250MB）
docs/html/

# ===== 日志与临时文件 =====
*.log
videodemo_debug.txt
test_onnx_log.txt
token_input_hex.txt
